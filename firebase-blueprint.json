{
  "entities": {
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application configuration, kill switch, version controls, and announcements",
      "type": "object",
      "properties": {
        "maintenanceMode": {
          "type": "boolean",
          "description": "Whether the app is under maintenance"
        },
        "maintenanceMessage": {
          "type": "string",
          "description": "Message to show when maintenance is active"
        },
        "latestVersion": {
          "type": "string",
          "description": "Current latest version of the app"
        },
        "minRequiredVersion": {
          "type": "string",
          "description": "Minimum version required to use the app"
        },
        "updateUrl": {
          "type": "string",
          "description": "Download link for new APK"
        },
        "forceUpdate": {
          "type": "boolean",
          "description": "Require update to use app"
        },
        "updateMessage": {
          "type": "string",
          "description": "Update notes or instructions"
        },
        "globalAnnouncement": {
          "type": "string",
          "description": "Broadcast message for users"
        },
        "showAnnouncement": {
          "type": "boolean",
          "description": "Whether to display announcement banner"
        },
        "adminPin": {
          "type": "string",
          "description": "PIN code for accessing control panel"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "maintenanceMode",
        "latestVersion",
        "minRequiredVersion"
      ]
    },
    "BlockedUser": {
      "title": "BlockedUser",
      "description": "List of usernames blocked from accessing the app",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "The blocked username (lowercase)"
        },
        "reason": {
          "type": "string",
          "description": "Reason for blocking"
        },
        "blockedAt": {
          "type": "string",
          "description": "When the block was created"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the block is currently active"
        }
      },
      "required": [
        "username",
        "active"
      ]
    }
  },
  "firestore": {
    "/app_config/{configId}": {
      "schema": "AppConfig",
      "description": "Stores remote app configuration documents"
    },
    "/blocked_users/{userId}": {
      "schema": "BlockedUser",
      "description": "Stores user blocking rules and status"
    }
  }
}
